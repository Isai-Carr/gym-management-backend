# ── Database ───────────────────────────────────────────────────────────────────
# Railway lo genera automáticamente al agregar el addon de PostgreSQL
DATABASE_URL="postgresql://user:password@host:5432/gym_management"

# ── JWT ────────────────────────────────────────────────────────────────────────
JWT_SECRET=""
JWT_REFRESH_SECRET=""

# ── Server ─────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# ── Email (Gmail SMTP) ─────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ── Frontend ───────────────────────────────────────────────────────────────────
FRONTEND_URL=https://url-del-frontend.com
ALLOWED_ORIGINS=https://url-del-frontend.com

# ── MercadoPago ────────────────────────────────────────────────────────────────
# Obtén tus credenciales en: https://www.mercadopago.com.mx/settings/account/credentials
# En producción usa las credenciales productivas (sin TEST-)
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
APP_URL=https://tu-dominio-en-railway.up.railway.app
